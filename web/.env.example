# AgsSwap web — copy to .env.local and fill with your project values.
# NEVER commit real values. `npm run build` works with these placeholders.

# --- Supabase (required for auth + data) — AgsSwap's OWN project, not RenoSwap's ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Service role: server-only (Stripe webhook, email alerts, account deletion). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute app URL. Set to https://agsswap.com for Production ONLY so Vercel
# previews fall back to their own host for Stripe redirects / email links.
# NEXT_PUBLIC_APP_URL=https://agsswap.com

# --- Stripe (billing / bumps) — use Test mode keys until launch ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
# Price IDs (Stripe → Products). Create with: node scripts/stripe-setup.mjs
STRIPE_PRICE_HOBBY=price_your-hobby-farm-monthly
STRIPE_PRICE_RANCH=price_your-ranch-farm-monthly
STRIPE_PRICE_BUMP=price_your-listing-bump

# --- Email (Resend) — optional; alerts are skipped when unset ---
# Sends from hello@agsswap.com, so agsswap.com must be verified in Resend.
RESEND_API_KEY=re_your-resend-key
